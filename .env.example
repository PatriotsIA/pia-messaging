# Direct quote delivery via EmailJS; leave unset to open an email draft instead.
# Configure the template's To Email as dan@patriotmessaging.com or {{to_email}},
# and Reply To as {{reply_to}}. Supported fields: name, title, message, time.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

VITE_SITE_URL=https://patriotmessaging.com
