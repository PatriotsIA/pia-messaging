# EmailJS (browser) - used for Contact and Messaging intake forms.
# Use the same EmailJS service/template/public-key values as pfa-pac.
# Default app payload matches a "Contact Us" template: name, title, message, time.
# VITE_EMAILJS_SERVICE_ID=
# VITE_EMAILJS_TEMPLATE_ID=
# VITE_EMAILJS_PUBLIC_KEY=

# Public site URL used for canonical tags, Open Graph URLs, robots.txt, and sitemap.xml.
VITE_SITE_URL=https://patriotmessaging.com
